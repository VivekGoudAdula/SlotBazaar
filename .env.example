# Environment variables for SlotBazaar
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is in .gitignore.

# Tiramisu testnet private key for scripts (MetaMask-managed for browser)
PRIVATE_KEY=

# Arkiv Project access key (rides in transport URL path, prevents ANON RATE LIMIT ERROR)
VITE_ARKIV_API_KEY=

# Optional: override RPC if you have a dedicated endpoint
VITE_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network
VITE_WS_URL=wss://rpc.tiramisu.db-chain.testnet.arkiv.network
VITE_CHAIN_ID=7738577
